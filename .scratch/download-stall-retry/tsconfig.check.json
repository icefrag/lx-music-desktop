{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@root/*": ["src/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"],
      "@lyric/*": ["src/renderer-lyric/*"],
      "@static/*": ["src/static/*"],
      "@common/*": ["src/common/*"]
    }
  },
  "include": [
    "../../src/renderer/worker/download/download.ts",
    "../../src/renderer/store/download/action.ts",
    "../../src/common/utils/download/index.ts",
    "../../src/common/utils/download/Downloader.ts",
    "../../src/common/types/download_list.d.ts",
    "../../src/common/types/**/*.d.ts",
    "../../src/renderer/types/**/*.d.ts",
    "../../src/main/types/**/*.d.ts"
  ],
  "exclude": ["../../node_modules", "../../dist"]
}
